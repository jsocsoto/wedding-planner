---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog-es');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const base = 'https://kimauraallen.com';
const canonicalUrl = `${base}/es/blog/${post.slug}/`;

const dateFormatted = new Date(post.data.date).toLocaleDateString('es-CR', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Layout
  title={`${post.data.title} — Kimaura Allen Events`}
  description={post.data.description}
  lang="es"
  canonicalUrl={canonicalUrl}
  ogImage={post.data.image}
>
  <Navigation lang="es" />

  <main class="post-main">
    {post.data.image && (
      <div class="post-hero">
        <img src={post.data.image} alt={post.data.title} class="post-hero-img" />
        <div class="post-hero-overlay"></div>
      </div>
    )}

    <article class="post-article">
      <header class="post-header">
        <div class="post-meta">
          <span class="post-category">{post.data.category}</span>
          <span class="post-sep">·</span>
          <time class="post-date">{dateFormatted}</time>
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
      </header>

      <div class="post-content">
        <Content />
      </div>

      <footer class="post-footer">
        <a href="/es/blog/" class="back-link">← Volver a la Revista</a>
      </footer>
    </article>
  </main>

  <Footer lang="es" />
</Layout>

<style>
  .post-main {
    padding-top: 80px;
    min-height: 100vh;
    background: var(--surface);
  }

  .post-hero {
    position: relative;
    height: 55vh;
    min-height: 320px;
    max-height: 600px;
    overflow: hidden;
  }

  .post-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }

  .post-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(58,21,1,0.25) 0%, rgba(58,21,1,0.55) 100%);
  }

  .post-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .post-header { margin-bottom: 3rem; }

  .post-meta {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--warm-taupe);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .post-sep { opacity: 0.5; }

  .post-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 400;
    color: var(--primary);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .post-desc {
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.7;
    border-left: 2px solid var(--outline-variant);
    padding-left: 1.25rem;
  }

  .post-content {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.85;
  }

  .post-content :global(h2) {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--primary);
    margin: 2.5rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--outline-variant);
  }

  .post-content :global(h3) {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--deep-earth);
    margin: 1.75rem 0 0.75rem;
  }

  .post-content :global(p) { margin-bottom: 1.25rem; }

  .post-content :global(strong) {
    font-weight: 600;
    color: var(--primary);
  }

  .post-content :global(em) { font-style: italic; }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--outline-variant);
    margin: 2.5rem 0;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--outline-variant);
  }

  .back-link {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm-taupe);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--primary); }

  @media (max-width: 600px) {
    .post-article { padding: 2.5rem 1.25rem 4rem; }
    .post-hero { height: 40vh; }
  }
</style>
