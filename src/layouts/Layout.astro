---
interface Props {
	title: string;
	description?: string;
	lang?: 'es' | 'en';
	canonicalUrl?: string;
	ogImage?: string;
}

const {
	title,
	description = "Luxury destination wedding planner in Costa Rica — specializing in intimate weddings, elopements, Caribbean ceremonies, and boutique wedding concierge experiences.",
	lang = 'es',
	canonicalUrl,
	ogImage: ogImageProp,
} = Astro.props;

const base      = 'https://kimauraallen.com';
const canonical = canonicalUrl ?? (lang === 'en' ? `${base}/` : `${base}/es/`);
const altEs     = `${base}/es/`;
const altEn     = `${base}/`;
const ogImage   = ogImageProp ?? `${base}/og-image.jpg`;
const ogLocale  = lang === 'es' ? 'es_CR' : 'en_US';

const schemaDescription = lang === 'en'
	? 'Luxury destination wedding planner in Costa Rica specializing in intimate weddings, elopements, Caribbean ceremonies, and boutique wedding concierge experiences.'
	: 'Wedding planner especializada en bodas de destino de lujo en Costa Rica — bodas íntimas, elopements, ceremonias en el Caribe y experiencias boutique de wedding concierge.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	additionalType: 'https://schema.org/LocalBusiness',
	name: 'Kimaura Allen Events',
	description: schemaDescription,
	url: base,
	telephone: '+50664708592',
	email: 'info@kimauraallen.com',
	image: ogImage,
	logo: `${base}/favicon-64.png`,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'San José',
		addressRegion: 'San José',
		addressCountry: 'CR',
	},
	sameAs: ['https://www.instagram.com/kimaurallen/'],
	priceRange: '$$$$',
	areaServed: { '@type': 'Country', name: 'Costa Rica' },
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: lang === 'en' ? 'Wedding Planning Services' : 'Servicios de Planificación de Bodas',
		itemListElement: [
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: lang === 'en' ? 'Destination Wedding Planning' : 'Planificación de Bodas de Destino' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: lang === 'en' ? 'Full Wedding Planning' : 'Planificación Completa de Bodas' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: lang === 'en' ? 'Wedding Concierge' : 'Wedding Concierge' } },
			{ '@type': 'Offer', itemOffered: { '@type': 'Service', name: lang === 'en' ? 'Luxury Elopements' : 'Elopements de Lujo' } },
		],
	},
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary meta -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<!-- hreflang -->
		<link rel="alternate" hreflang="es" href={altEs} />
		<link rel="alternate" hreflang="en" href={altEn} />
		<link rel="alternate" hreflang="x-default" href={altEs} />

		<!-- Open Graph -->
		<meta property="og:type"        content="website" />
		<meta property="og:url"         content={canonical} />
		<meta property="og:title"       content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image"       content={ogImage} />
		<meta property="og:locale"      content={ogLocale} />
		<meta property="og:site_name"   content="Kimaura Allen Events" />

		<!-- Twitter Card -->
		<meta name="twitter:card"        content="summary_large_image" />
		<meta name="twitter:title"       content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image"       content={ogImage} />

		<!-- Favicons -->
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Montserrat:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* ══════════════════════════════════════════
	   TOKENS — Stitch "Tropical Minimalism"
	══════════════════════════════════════════ */
	:root {
		--primary:          #3a1501;
		--deep-earth:       #552910;
		--soft-blush:       #f4dbd8;
		--warm-taupe:       #bfa09c;
		--muted-rose:       #d9c2c0;
		--surface:          #fcf9f8;
		--surface-low:      #f6f3f2;
		--surface-container:#f0edec;
		--outline:          #84746c;
		--outline-variant:  #d7c2ba;
		--text-primary:     #1b1c1b;
		--text-secondary:   #52443d;
	}

	/* ══════════════════════════════════════════
	   RESET
	══════════════════════════════════════════ */
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	/* ══════════════════════════════════════════
	   BASE
	══════════════════════════════════════════ */
	html {
		font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
		scroll-behavior: smooth;
		background: var(--surface);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		color: var(--text-primary);
		line-height: 1.6;
		overflow-x: hidden;
		background: var(--surface);
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Playfair Display', Georgia, serif;
		font-weight: 400;
		line-height: 1.2;
		color: var(--primary);
	}

	img {
		display: block;
		max-width: 100%;
	}

	a {
		color: inherit;
	}

	/* Scroll offset for fixed header */
	section[id] {
		scroll-margin-top: 72px;
	}

	/* Material Symbols base */
	.material-symbols-outlined {
		font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
		vertical-align: middle;
		line-height: 1;
	}

	/* Selection color */
	::selection {
		background: var(--soft-blush);
		color: var(--deep-earth);
	}
</style>
