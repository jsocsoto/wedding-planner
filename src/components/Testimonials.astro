---
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Testimonios',
    testimonials: [
      { quote: '¡Wow! Aún no puedo creer lo hermosa que estuvo la decoración. Básicamente organizaste la boda del año. Gracias por toda la magia que ayudaste a crear en ese día.', name: 'Davia & Greg', venue: 'Puerto Viejo, Limón' },
      { quote: 'Muchas gracias por toda la organización, fue un éxito. Todas las personas quedaron muy contentas y lo mejor fue que María José disfrutó muchísimo.', name: 'José Armando Rodríguez', venue: 'Hotel Intercontinental, San José' },
      { quote: 'Kim, después de tanto ajetreo y el estrés, vengo a agradecerte por todo. Muchas gracias por tus servicios y tu ayuda, ¡y a tu mamá también! Se logró el objetivo y nos sentimos muy felices de que todo salió excelente.', name: 'Aybell & Jean Carlo', venue: 'Westfalia, Limón' },
      { quote: 'Kim se interesa genuinamente en conocer a las parejas a las que les brinda el servicio. Me encanta la primera sesión donde prepara una presentación muy linda. Es una persona flexible, abierta a ideas y se ajusta a cualquier presupuesto o tamaño de evento. ¡Lo que sea, ella lo puede hacer realidad!', name: 'Beto & Mari', venue: 'Hotel Intercontinental' },
    ],
  },
  en: {
    eyebrow: 'Testimonials',
    testimonials: [
      { quote: 'Wow! I still can\'t believe how beautiful the setup was. You basically put on the wedding of the year. Thank you for all the magic you helped create on this day.', name: 'Davia & Greg', venue: 'Puerto Viejo, Limón' },
      { quote: 'Thank you so much for all the organization — it was a complete success. Everyone was very happy, and best of all, María José had an amazing time.', name: 'José Armando Rodríguez', venue: 'Hotel Intercontinental, San José' },
      { quote: 'Kim, after all the running around and the stress, I just want to thank you for everything. Thank you for your services and your help — and to your mom too! We achieved our goal and we\'re so happy that everything went beautifully.', name: 'Aybell & Jean Carlo', venue: 'Westfalia, Limón' },
      { quote: 'Kim genuinely takes an interest in getting to know the couples she works with. I love the first session where she prepares a beautiful presentation. She\'s flexible, open to ideas, and adapts to any budget or event size. Whatever you dream of, she can make it happen!', name: 'Beto & Mari', venue: 'Hotel Intercontinental' },
    ],
  },
};

const c = copy[lang];
---

<section id="testimonials" class="testimonials">
  <div class="testimonials-inner">

    <div class="testi-header">
      <span class="section-eyebrow">{c.eyebrow}</span>
    </div>

    <div class="testi-track">
      {c.testimonials.map((t, i) => (
        <div class={`testi-slide ${i === 0 ? 'is-active' : ''}`} data-index={i}>
          <div class="quote-mark">"</div>
          <blockquote class="quote-text">{t.quote}</blockquote>
          <footer class="quote-footer">
            <span class="quote-name">— {t.name}</span>
            <span class="quote-venue">{t.venue}</span>
          </footer>
        </div>
      ))}
    </div>

    <nav class="testi-nav" aria-label="Testimonios">
      {c.testimonials.map((t, i) => (
        <button class={`testi-dot ${i === 0 ? 'is-active' : ''}`} data-i={i} aria-label={t.name}></button>
      ))}
    </nav>

  </div>
</section>

<style>
  .testimonials {
    padding: 8rem 0;
    background: rgba(244,219,216,0.2);
    position: relative;
    overflow: hidden;
  }

  .testimonials::before {
    content: '\201C';
    position: absolute;
    top: -2rem; left: 50%;
    transform: translateX(-50%);
    font-family: 'Playfair Display', serif;
    font-size: 20rem;
    color: rgba(191,160,156,0.08);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .testimonials-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 80px;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .testi-header { margin-bottom: 3rem; }

  .section-eyebrow {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--warm-taupe);
  }

  .testi-track {
    position: relative;
    min-height: 220px;
    margin-bottom: 2.5rem;
  }

  .testi-slide {
    display: none;
    flex-direction: column;
    align-items: center;
    animation: slideIn 0.55s cubic-bezier(0.25,0.46,0.45,0.94) both;
  }

  .testi-slide.is-active { display: flex; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .quote-mark {
    font-family: 'Playfair Display', serif;
    font-size: 5rem;
    color: var(--warm-taupe);
    opacity: 0.4;
    line-height: 0.6;
    margin-bottom: 1.5rem;
    user-select: none;
  }

  .quote-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.2rem, 2.2vw, 1.75rem);
    font-weight: 400;
    font-style: italic;
    color: var(--primary);
    line-height: 1.55;
    margin-bottom: 2rem;
    max-width: 680px;
  }

  .quote-footer { display: flex; flex-direction: column; gap: 0.3rem; }

  .quote-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--deep-earth);
  }

  .quote-venue {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--warm-taupe);
    font-style: italic;
  }

  .testi-nav { display: flex; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }

  .testi-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    border: 1px solid var(--warm-taupe);
    background: transparent;
    padding: 0; cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .testi-dot.is-active {
    background: var(--deep-earth);
    border-color: var(--deep-earth);
    transform: scale(1.3);
  }

  @media (max-width: 900px) {
    .testimonials-inner { padding: 0 24px; }
    .testi-track { min-height: 280px; }
    .quote-text { font-size: 1.25rem; }
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.testi-slide'));
  const dots   = Array.from(document.querySelectorAll<HTMLButtonElement>('.testi-dot'));
  let current  = 0;
  let timer: ReturnType<typeof setInterval>;

  function go(idx: number) {
    slides[current].classList.remove('is-active');
    dots[current].classList.remove('is-active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    dots[current].classList.add('is-active');
  }

  function startTimer() { timer = setInterval(() => go(current + 1), 7000); }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { clearInterval(timer); go(i); startTimer(); });
  });

  startTimer();
</script>
