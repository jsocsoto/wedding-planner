---
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Portfolio',
    title:   'Historias Inolvidables',
    sub:     'Bodas de destino en Costa Rica — desde la costa caribeña de Limón hasta las colinas de Escazú.',
    cta:     'Ver todas las historias →',
    quote:   '"Cada celebración debe contar una historia real."',
  },
  en: {
    eyebrow: 'Portfolio',
    title:   'Unforgettable Stories',
    sub:     'Destination weddings across Costa Rica — from the Caribbean coast of Limón to the hills of Escazú and beyond.',
    cta:     'See all stories →',
    quote:   '"Every celebration should tell a real story."',
  },
};

const c = copy[lang];
---

<section id="gallery" class="portfolio">
  <div class="portfolio-inner">

    <header class="portfolio-header">
      <div>
        <span class="section-eyebrow">{c.eyebrow}</span>
        <h2 class="section-title">{c.title}</h2>
        <p class="section-sub">{c.sub}</p>
      </div>
      <a href="#contact" class="view-all">{c.cta}</a>
    </header>

    <div class="grid-layout">

      <div class="cell cell-a">
        <div class="img-wrap">
          <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=1400&q=85"
               alt="Intimate Caribbean wedding ceremony in Westfalia, Limón, Costa Rica" style="object-position:center 40%" loading="lazy" />
          <div class="img-overlay"><span class="img-label">Westfalia, Limón</span></div>
        </div>
      </div>

      <div class="cell cell-b">
        <button class="img-wrap img-wrap--gallery" id="openPuertoViejo" aria-label="Ver galería Puerto Viejo">
          <img src="/gallery/puerto-viejo/principal.jpeg"
               alt="Luxury destination wedding in Puerto Viejo, Caribbean coast of Limón, Costa Rica" style="object-position:center top" loading="lazy" />
          <div class="img-overlay">
            <span class="img-label">Puerto Viejo, Limón</span>
            <span class="gallery-hint">
              <span class="material-symbols-outlined">photo_library</span>
              Ver galería
            </span>
          </div>
        </button>
      </div>

      <div class="cell cell-c">
        <button class="img-wrap img-wrap--gallery" id="openSanRafael" aria-label="Ver galería San Rafael">
          <img src="/gallery/san-rafael/principal.jpeg"
               alt="Intimate garden wedding in San Rafael, Heredia, Costa Rica" style="object-position:center" loading="lazy" />
          <div class="img-overlay">
            <span class="img-label">San Rafael, Heredia</span>
            <span class="gallery-hint">
              <span class="material-symbols-outlined">photo_library</span>
              Ver galería
            </span>
          </div>
        </button>
      </div>

      <div class="cell cell-d">
        <button class="img-wrap img-wrap--gallery" id="openEscazu" aria-label="Ver galería Escazú">
          <img src="/gallery/escazu/principal.jpeg"
               alt="Luxury wedding reception in Escazú, San José, Costa Rica" style="object-position:center 30%" loading="lazy" />
          <div class="img-overlay">
            <span class="img-label">Escazú, San José</span>
            <span class="gallery-hint">
              <span class="material-symbols-outlined">photo_library</span>
              Ver galería
            </span>
          </div>
        </button>
      </div>

      <div class="cell cell-quote">
        <div class="quote-block">
          <p class="quote-text">{c.quote}</p>
          <span class="quote-attr">— Kimaura Allen</span>
        </div>
      </div>

      <div class="cell cell-e">
        <button class="img-wrap img-wrap--gallery video-preview" id="openOrosi" aria-label="Ver video Orosí">
          <video src="/gallery/orosi/principal.mp4" autoplay muted loop playsinline class="preview-video"></video>
          <div class="img-overlay">
            <span class="img-label">Orosí, Cartago</span>
            <span class="gallery-hint">
              <span class="material-symbols-outlined">play_circle</span>
              Ver video
            </span>
          </div>
        </button>
      </div>

      <div class="cell cell-f">
        <button class="img-wrap img-wrap--gallery" id="openEmotionalMoments" aria-label="Ver galería Emotional Moments">
          <img src="/gallery/emotional-moments/principal.jpeg"
               alt="Emotional wedding moments captured during a boutique celebration in Costa Rica" style="object-position:center" loading="lazy" />
          <div class="img-overlay">
            <span class="img-label">Emotional Moments</span>
            <span class="gallery-hint">
              <span class="material-symbols-outlined">photo_library</span>
              Ver galería
            </span>
          </div>
        </button>
      </div>

    </div>
  </div>
</section>

<!-- Lightbox Puerto Viejo -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Galería Puerto Viejo" hidden>
  <button class="lb-close" id="lbClose" aria-label="Cerrar">
    <span class="material-symbols-outlined">close</span>
  </button>
  <button class="lb-prev" id="lbPrev" aria-label="Anterior">
    <span class="material-symbols-outlined">chevron_left</span>
  </button>
  <div class="lb-img-wrap">
    <img class="lb-img" id="lbImg" src="" alt="" />
    <video class="lb-video" id="lbVideo" controls playsinline></video>
  </div>
  <button class="lb-next" id="lbNext" aria-label="Siguiente">
    <span class="material-symbols-outlined">chevron_right</span>
  </button>
  <div class="lb-counter" id="lbCounter"></div>
</div>

<style>
  .portfolio { padding: 8rem 0; }

  .portfolio-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }

  .portfolio-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .section-eyebrow {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--warm-taupe);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    color: var(--primary);
    margin: 0 0 0.5rem;
  }

  .section-sub {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--text-secondary);
    opacity: 0.75;
    line-height: 1.6;
    max-width: 480px;
    margin: 0;
  }

  .view-all {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--deep-earth);
    text-decoration: none;
    border-bottom: 1px solid var(--deep-earth);
    padding-bottom: 2px;
    white-space: nowrap;
    align-self: flex-end;
    margin-bottom: 2px;
    transition: opacity 0.25s ease;
  }

  .view-all:hover { opacity: 0.6; color: var(--deep-earth); }

  /* ── Grid ──────────────────────────────── */
  .grid-layout {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.75rem;
  }

  .cell-a { grid-column: 1 / 8;   grid-row: 1; }
  .cell-b { grid-column: 8 / 13;  grid-row: 1; }
  .cell-c { grid-column: 1 / 5;   grid-row: 2; margin-top: -6rem; }
  .cell-d { grid-column: 5 / 10;  grid-row: 2; }
  .cell-quote { grid-column: 10 / 13; grid-row: 2; margin-top: -4rem; }
  .cell-e { grid-column: 1 / 5;   grid-row: 3; }
  .cell-f { grid-column: 5 / 13;  grid-row: 3; }

  .cell-a .img-wrap { aspect-ratio: 16 / 10; }
  .cell-b .img-wrap { aspect-ratio: 3 / 4; }
  .cell-c .img-wrap { aspect-ratio: 3 / 4; }
  .cell-d .img-wrap { aspect-ratio: 4 / 3; }
  .cell-e .img-wrap { aspect-ratio: 1 / 1; }
  .cell-f .img-wrap { aspect-ratio: 16 / 7; }

  .img-wrap { position: relative; overflow: hidden; }

  .img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: saturate(0.92);
  }

  .img-wrap:hover img { transform: scale(1.05); filter: saturate(1.05); }

  .img-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(28,16,10,0.45) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
    display: flex; align-items: flex-end;
    padding: 1.25rem;
  }

  .img-wrap:hover .img-overlay { opacity: 1; }

  .img-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244,219,216,0.9);
  }

  .quote-block {
    background: var(--soft-blush);
    height: 100%;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem;
  }

  .quote-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1rem, 1.4vw, 1.35rem);
    font-weight: 400;
    font-style: italic;
    color: var(--deep-earth);
    line-height: 1.45;
    margin-bottom: 1rem;
  }

  .quote-attr {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm-taupe);
  }

  /* ── Responsive ────────────────────────── */
  @media (max-width: 900px) {
    .portfolio-inner { padding: 0 24px; }

    .grid-layout { grid-template-columns: 1fr 1fr; gap: 0.5rem; }

    .cell-a  { grid-column: 1 / 3; grid-row: auto; }
    .cell-b, .cell-c, .cell-d, .cell-e { grid-column: span 1; grid-row: auto; margin-top: 0; }
    .cell-quote, .cell-f { grid-column: 1 / 3; grid-row: auto; margin-top: 0; }

    .cell-a .img-wrap,
    .cell-b .img-wrap,
    .cell-c .img-wrap,
    .cell-d .img-wrap,
    .cell-e .img-wrap { aspect-ratio: 4 / 3; }
    .cell-f .img-wrap { aspect-ratio: 16 / 9; }

    .quote-block { min-height: unset; padding: 2rem; }
    .img-overlay { opacity: 1; }
  }

  @media (max-width: 540px) {
    .grid-layout { grid-template-columns: 1fr; }
    .cell-a, .cell-b, .cell-c, .cell-d, .cell-e, .cell-quote, .cell-f { grid-column: 1; }
  }

  /* Video preview in grid */
  .preview-video {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Lightbox video */
  .lb-video {
    max-width: 100%;
    max-height: 90vh;
    display: none;
    outline: none;
  }

  .lb-video.is-active { display: block; }
  .lb-img.is-hidden   { display: none; }

  /* Gallery button cell */
  .img-wrap--gallery {
    all: unset;
    display: block;
    cursor: pointer;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .img-wrap--gallery .img-overlay { opacity: 1; }

  .gallery-hint {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244,219,216,0.85);
    margin-top: 0.4rem;
  }

  .gallery-hint .material-symbols-outlined { font-size: 0.95rem; }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(20, 12, 8, 0.96);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem;
  }

  .lightbox[hidden] { display: none; }

  .lb-img-wrap {
    flex: 1;
    max-width: 860px;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb-img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    display: block;
  }

  .lb-close {
    position: absolute;
    top: 1.25rem; right: 1.25rem;
    background: none; border: none; cursor: pointer;
    color: rgba(244,219,216,0.75);
    transition: color 0.2s ease;
    line-height: 1; padding: 0.25rem;
  }

  .lb-close:hover { color: #fdf8f6; }
  .lb-close .material-symbols-outlined { font-size: 2rem; }

  .lb-prev, .lb-next {
    background: none; border: none; cursor: pointer;
    color: rgba(244,219,216,0.65);
    transition: color 0.2s ease;
    flex-shrink: 0; padding: 0.5rem;
  }

  .lb-prev:hover, .lb-next:hover { color: #fdf8f6; }
  .lb-prev .material-symbols-outlined,
  .lb-next .material-symbols-outlined { font-size: 3rem; }

  .lb-counter {
    position: absolute;
    bottom: 1.25rem; left: 50%;
    transform: translateX(-50%);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem; font-weight: 600;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: rgba(244,219,216,0.5);
  }

  @media (max-width: 600px) {
    .lb-prev .material-symbols-outlined,
    .lb-next .material-symbols-outlined { font-size: 2rem; }
  }
</style>

<script>
  const galleries: Record<string, string[]> = {
    openPuertoViejo: [
      '/gallery/puerto-viejo/principal.jpeg',
      '/gallery/puerto-viejo/pv-1.jpeg',
      '/gallery/puerto-viejo/pv-2.jpeg',
      '/gallery/puerto-viejo/pv-3.jpeg',
      '/gallery/puerto-viejo/pv-4.jpeg',
      '/gallery/puerto-viejo/pv-5.jpeg',
    ],
    openEscazu: [
      '/gallery/escazu/principal.jpeg',  // 1
      '/gallery/escazu/es-1.jpeg',       // 2
      '/gallery/escazu/es-5.jpeg',       // 3
      '/gallery/escazu/es-6.jpeg',       // 4
      '/gallery/escazu/es-7.jpeg',       // 5
      '/gallery/escazu/es-8.jpeg',       // 6
      '/gallery/escazu/es-9.jpeg',       // 7
      '/gallery/escazu/es-10.jpeg',      // 8
      '/gallery/escazu/es-11.jpeg',      // 9
      '/gallery/escazu/es-4.jpeg',       // 10
      '/gallery/escazu/es-2.jpeg',       // 11
      '/gallery/escazu/es-3.jpeg',       // 12
    ],
    openSanRafael: [
      '/gallery/san-rafael/principal.jpeg',
      '/gallery/san-rafael/sr-1.jpeg',
      '/gallery/san-rafael/sr-2.jpeg',
      '/gallery/san-rafael/sr-3.jpeg',
      '/gallery/san-rafael/sr-4.jpeg',
      '/gallery/san-rafael/sr-5.jpeg',
    ],
    openEmotionalMoments: [
      '/gallery/emotional-moments/principal.jpeg',
      '/gallery/emotional-moments/em-2.jpeg',
      '/gallery/emotional-moments/em-3.jpeg',
      '/gallery/emotional-moments/em-4.mp4',
      '/gallery/emotional-moments/em-5.jpeg',
    ],
  };

  const videoOnly: Record<string, string> = {
    openOrosi: '/gallery/orosi/principal.mp4',
  };

  const lightbox  = document.getElementById('lightbox')  as HTMLElement;
  const lbImg     = document.getElementById('lbImg')     as HTMLImageElement;
  const lbVideo   = document.getElementById('lbVideo')   as HTMLVideoElement;
  const lbCounter = document.getElementById('lbCounter') as HTMLElement;
  const lbPrev    = document.getElementById('lbPrev')    as HTMLElement;
  const lbNext    = document.getElementById('lbNext')    as HTMLElement;
  const lbClose   = document.getElementById('lbClose')!;

  let items: string[] = [];
  let current = 0;
  let videoOnlyMode = false;

  function isVideoSrc(src: string) {
    return /\.(mp4|webm|mov)$/i.test(src);
  }

  function showItem(idx: number) {
    current = (idx + items.length) % items.length;
    const src = items[current];
    lbCounter.textContent = `${current + 1} / ${items.length}`;
    lbPrev.style.visibility = 'visible';
    lbNext.style.visibility = 'visible';

    if (isVideoSrc(src)) {
      lbImg.classList.add('is-hidden');
      lbVideo.classList.add('is-active');
      lbVideo.src = src;
      lbVideo.load();
    } else {
      lbImg.classList.remove('is-hidden');
      lbVideo.classList.remove('is-active');
      lbVideo.pause();
      lbVideo.src = '';
      lbImg.src = src;
    }
  }

  function openGallery(id: string) {
    videoOnlyMode = false;
    items = galleries[id];
    showItem(0);
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function openVideoOnly(id: string) {
    videoOnlyMode = true;
    items = [];
    lbImg.classList.add('is-hidden');
    lbVideo.classList.add('is-active');
    lbVideo.src = videoOnly[id];
    lbVideo.load();
    lbCounter.textContent = '';
    lbPrev.style.visibility = 'hidden';
    lbNext.style.visibility = 'hidden';
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.hidden = true;
    lbVideo.pause();
    lbVideo.src = '';
    document.body.style.overflow = '';
  }

  Object.keys(galleries).forEach(id => {
    document.getElementById(id)?.addEventListener('click', () => openGallery(id));
  });

  Object.keys(videoOnly).forEach(id => {
    document.getElementById(id)?.addEventListener('click', () => openVideoOnly(id));
  });

  lbClose.addEventListener('click', close);
  lbPrev.addEventListener('click', () => { if (!videoOnlyMode) showItem(current - 1); });
  lbNext.addEventListener('click', () => { if (!videoOnlyMode) showItem(current + 1); });

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox.hidden) return;
    if (e.key === 'Escape')                         close();
    if (e.key === 'ArrowLeft'  && !videoOnlyMode)   showItem(current - 1);
    if (e.key === 'ArrowRight' && !videoOnlyMode)   showItem(current + 1);
  });
</script>
