---
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Portfolio',
    title:   'Historias Inolvidables',
    cta:     'Ver todas las historias →',
    quote:   '"Cada celebración debe contar una historia real."',
  },
  en: {
    eyebrow: 'Portfolio',
    title:   'Unforgettable Stories',
    cta:     'See all stories →',
    quote:   '"Every celebration should tell a real story."',
  },
};

const c = copy[lang];
---

<section id="gallery" class="portfolio">
  <div class="portfolio-inner">

    <header class="portfolio-header">
      <div>
        <span class="section-eyebrow">{c.eyebrow}</span>
        <h2 class="section-title">{c.title}</h2>
      </div>
      <a href="#contact" class="view-all">{c.cta}</a>
    </header>

    <div class="grid-layout">

      <div class="cell cell-a">
        <div class="img-wrap">
          <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=1400&q=85"
               alt="Intimate ocean ceremony" style="object-position:center 40%" loading="lazy" />
          <div class="img-overlay"><span class="img-label">Westfalia, Limón</span></div>
        </div>
      </div>

      <div class="cell cell-b">
        <div class="img-wrap">
          <img src="https://images.unsplash.com/photo-1606216794074-735e91aa2c92?w=900&q=85"
               alt="Sunset couple" style="object-position:center top" loading="lazy" />
          <div class="img-overlay"><span class="img-label">Puerto Viejo, Limón</span></div>
        </div>
      </div>

      <div class="cell cell-c">
        <div class="img-wrap">
          <img src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=900&q=85"
               alt="Floral details" style="object-position:center" loading="lazy" />
          <div class="img-overlay"><span class="img-label">Flores tropicales</span></div>
        </div>
      </div>

      <div class="cell cell-d">
        <div class="img-wrap">
          <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=1200&q=85"
               alt="Elegant table setting" style="object-position:center 60%" loading="lazy" />
          <div class="img-overlay"><span class="img-label">Escazú, San José</span></div>
        </div>
      </div>

      <div class="cell cell-quote">
        <div class="quote-block">
          <p class="quote-text">{c.quote}</p>
          <span class="quote-attr">— Kimaura Allen</span>
        </div>
      </div>

      <div class="cell cell-e">
        <div class="img-wrap">
          <img src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=900&q=85"
               alt="Romantic couple moment" style="object-position:center top" loading="lazy" />
          <div class="img-overlay"><span class="img-label">Orosí, Cartago</span></div>
        </div>
      </div>

      <div class="cell cell-f">
        <div class="img-wrap">
          <img src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?w=1200&q=85"
               alt="Luxury tropical venue" style="object-position:center" loading="lazy" />
          <div class="img-overlay"><span class="img-label">San Pablo, Heredia</span></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .portfolio { padding: 8rem 0; }

  .portfolio-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }

  .portfolio-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .section-eyebrow {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--warm-taupe);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    color: var(--primary);
    margin: 0;
  }

  .view-all {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--deep-earth);
    text-decoration: none;
    border-bottom: 1px solid var(--deep-earth);
    padding-bottom: 2px;
    white-space: nowrap;
    align-self: flex-end;
    margin-bottom: 2px;
    transition: opacity 0.25s ease;
  }

  .view-all:hover { opacity: 0.6; color: var(--deep-earth); }

  /* ── Grid ──────────────────────────────── */
  .grid-layout {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.75rem;
  }

  .cell-a { grid-column: 1 / 8;   grid-row: 1; }
  .cell-b { grid-column: 8 / 13;  grid-row: 1; }
  .cell-c { grid-column: 1 / 5;   grid-row: 2; margin-top: -6rem; }
  .cell-d { grid-column: 5 / 10;  grid-row: 2; }
  .cell-quote { grid-column: 10 / 13; grid-row: 2; margin-top: -4rem; }
  .cell-e { grid-column: 1 / 5;   grid-row: 3; }
  .cell-f { grid-column: 5 / 13;  grid-row: 3; }

  .cell-a .img-wrap { aspect-ratio: 16 / 10; }
  .cell-b .img-wrap { aspect-ratio: 3 / 4; }
  .cell-c .img-wrap { aspect-ratio: 3 / 4; }
  .cell-d .img-wrap { aspect-ratio: 4 / 3; }
  .cell-e .img-wrap { aspect-ratio: 1 / 1; }
  .cell-f .img-wrap { aspect-ratio: 16 / 7; }

  .img-wrap { position: relative; overflow: hidden; }

  .img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: saturate(0.92);
  }

  .img-wrap:hover img { transform: scale(1.05); filter: saturate(1.05); }

  .img-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(28,16,10,0.45) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
    display: flex; align-items: flex-end;
    padding: 1.25rem;
  }

  .img-wrap:hover .img-overlay { opacity: 1; }

  .img-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244,219,216,0.9);
  }

  .quote-block {
    background: var(--soft-blush);
    height: 100%;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem;
  }

  .quote-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1rem, 1.4vw, 1.35rem);
    font-weight: 400;
    font-style: italic;
    color: var(--deep-earth);
    line-height: 1.45;
    margin-bottom: 1rem;
  }

  .quote-attr {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm-taupe);
  }

  /* ── Responsive ────────────────────────── */
  @media (max-width: 900px) {
    .portfolio-inner { padding: 0 24px; }

    .grid-layout { grid-template-columns: 1fr 1fr; gap: 0.5rem; }

    .cell-a  { grid-column: 1 / 3; grid-row: auto; }
    .cell-b, .cell-c, .cell-d, .cell-e { grid-column: span 1; grid-row: auto; margin-top: 0; }
    .cell-quote, .cell-f { grid-column: 1 / 3; grid-row: auto; margin-top: 0; }

    .cell-a .img-wrap,
    .cell-b .img-wrap,
    .cell-c .img-wrap,
    .cell-d .img-wrap,
    .cell-e .img-wrap { aspect-ratio: 4 / 3; }
    .cell-f .img-wrap { aspect-ratio: 16 / 9; }

    .quote-block { min-height: unset; padding: 2rem; }
    .img-overlay { opacity: 1; }
  }

  @media (max-width: 540px) {
    .grid-layout { grid-template-columns: 1fr; }
    .cell-a, .cell-b, .cell-c, .cell-d, .cell-e, .cell-quote, .cell-f { grid-column: 1; }
  }
</style>
