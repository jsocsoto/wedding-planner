---
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Costa Rica · Destination Weddings',
    title:   'Experiencias que\ncuentan tu historia.',
    sub:     'Bodas de lujo en destinos paradisíacos y celebraciones personalizadas en Costa Rica.',
    cta1:    'Agenda tu experiencia',
    cta2:    'Explorar servicios',
  },
  en: {
    eyebrow: 'Luxury Wedding Planner · Costa Rica',
    title:   'Experiences that\ntell your story.',
    sub:     'Boutique destination wedding planning in Costa Rica — intimate ceremonies, luxury elopements, and Caribbean celebrations designed around you.',
    cta1:    'Plan your experience',
    cta2:    'Explore services',
  },
};

const c = copy[lang];
---

<section id="home" class="hero">
  <div class="hero-media">
    <img
      src="https://images.unsplash.com/photo-1606216794074-735e91aa2c92?w=1920&q=90"
      alt="Luxury wedding in Costa Rica"
      class="hero-img"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-body">
    <div class="hero-eyebrow">
      <span class="eyebrow-line"></span>
      <span class="eyebrow-text">{c.eyebrow}</span>
    </div>
    <h1 class="hero-title">
      {c.title.split('\n').map((line, i) => (
        <>{line}{i < c.title.split('\n').length - 1 && <br/>}</>
      ))}
    </h1>
    <p class="hero-sub">{c.sub}</p>
    <div class="hero-actions">
      <a href="#contact" class="btn-fill">{c.cta1}</a>
      <a href="#services" class="btn-outline">{c.cta2}</a>
    </div>
  </div>

  <div class="hero-scroll">
    <span class="scroll-line"></span>
    <span class="scroll-label">Scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    transform: scale(1.04);
    animation: slowZoom 18s ease-out forwards;
  }

  @keyframes slowZoom {
    to { transform: scale(1); }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right,  rgba(28, 16, 10, 0.58) 0%, rgba(28, 16, 10, 0.12) 65%, transparent 100%),
      linear-gradient(to top,    rgba(28, 16, 10, 0.45) 0%, transparent 50%);
  }

  .hero-body {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 0 80px;
    animation: fadeUp 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .eyebrow-line {
    display: block;
    width: 40px;
    height: 1px;
    background: rgba(244, 219, 216, 0.7);
  }

  .eyebrow-text {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(244, 219, 216, 0.85);
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 400;
    color: #fdf8f6;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    max-width: 700px;
  }

  .hero-sub {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(0.9rem, 1.4vw, 1.1rem);
    font-weight: 300;
    color: rgba(253, 248, 246, 0.85);
    line-height: 1.65;
    letter-spacing: 0.01em;
    max-width: 460px;
    margin-bottom: 2.75rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-fill {
    display: inline-block;
    padding: 1.05rem 2.25rem;
    background: var(--deep-earth);
    color: var(--soft-blush);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }

  .btn-fill:hover { opacity: 0.88; color: var(--soft-blush); }

  .btn-outline {
    display: inline-block;
    padding: 1.05rem 2.25rem;
    background: transparent;
    color: rgba(253, 248, 246, 0.9);
    border: 1px solid rgba(244, 219, 216, 0.55);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s ease;
    backdrop-filter: blur(4px);
  }

  .btn-outline:hover {
    background: rgba(244, 219, 216, 0.12);
    border-color: rgba(244, 219, 216, 0.8);
    color: #fdf8f6;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 80px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: fadeUp 1.2s ease 1.2s both;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 40px;
    background: rgba(244, 219, 216, 0.5);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; }
    50%       { opacity: 1; }
  }

  .scroll-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(244, 219, 216, 0.6);
    writing-mode: vertical-rl;
  }

  @media (max-width: 900px) {
    .hero-body, .hero-scroll { padding: 0 24px; }
    .hero-scroll { left: 24px; }
    .hero-title { font-size: clamp(2.25rem, 9vw, 3.25rem); }
    .hero-actions { flex-direction: column; gap: 0.75rem; max-width: 320px; }
    .btn-fill, .btn-outline { text-align: center; }
  }
</style>
