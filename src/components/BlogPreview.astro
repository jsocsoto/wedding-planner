---
import { getCollection } from 'astro:content';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

const collection = lang === 'en' ? 'blog-en' : 'blog-es';
const posts = (await getCollection(collection))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const blogHref  = lang === 'en' ? '/blog/'    : '/es/blog/';
const postBase  = lang === 'en' ? '/blog/'    : '/es/blog/';

const copy = {
  es: { eyebrow: 'La Revista', heading: 'Últimas publicaciones', cta: 'Ver todos los artículos' },
  en: { eyebrow: 'The Journal', heading: 'Latest Articles', cta: 'View all articles' },
};
const c = copy[lang];
---

<section class="blog-preview" id="journal">
  <div class="bp-inner">
    <header class="bp-header">
      <p class="bp-eyebrow">{c.eyebrow}</p>
      <h2 class="bp-heading">{c.heading}</h2>
    </header>

    <div class="bp-grid">
      {posts.map((post, i) => (
        <article class="bp-card">
          {post.data.image && (
            <a href={`${postBase}${post.slug}/`} class="bp-img-wrap" tabindex="-1" aria-hidden="true">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="bp-img"
                loading="lazy"
              />
            </a>
          )}
          <div class="bp-body">
            <span class="bp-cat">{post.data.category}</span>
            <h3 class="bp-title">
              <a href={`${postBase}${post.slug}/`}>{post.data.title}</a>
            </h3>
            <p class="bp-desc">{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="bp-footer">
      <a href={blogHref} class="bp-cta">{c.cta}</a>
    </div>
  </div>
</section>

<style>
  .blog-preview {
    background: var(--surface-low);
    padding: 6rem 0;
  }

  .bp-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .bp-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .bp-eyebrow {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--warm-taupe);
    margin-bottom: 0.75rem;
  }

  .bp-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 400;
    color: var(--primary);
  }

  .bp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .bp-card {
    background: var(--surface);
    border: 1px solid var(--outline-variant);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.3s ease;
  }

  .bp-card:hover {
    box-shadow: 0 8px 32px rgba(58, 21, 1, 0.08);
  }

  .bp-img-wrap {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .bp-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .bp-img-wrap:hover .bp-img { transform: scale(1.04); }

  .bp-body {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .bp-cat {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm-taupe);
  }

  .bp-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--primary);
  }

  .bp-title a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s;
  }

  .bp-title a:hover { color: var(--deep-earth); }

  .bp-desc {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .bp-footer {
    text-align: center;
  }

  .bp-cta {
    display: inline-block;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--primary);
    text-decoration: none;
    border: 1px solid var(--primary);
    padding: 0.85rem 2.5rem;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .bp-cta:hover {
    background: var(--primary);
    color: var(--soft-blush);
  }

  @media (max-width: 900px) {
    .bp-inner { padding: 0 24px; }
    .bp-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  }

  @media (max-width: 580px) {
    .bp-grid { grid-template-columns: 1fr; }
    .blog-preview { padding: 4rem 0; }
  }
</style>
