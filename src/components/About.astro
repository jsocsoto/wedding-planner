---
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Sobre mí',
    headline: 'Creo en las bodas que se sienten auténticas, íntimas y profundamente significativas.',
    body: [
      'Soy Kimaura, la persona detrás de <em>Kimaura Allen Events</em> — una marca creada desde la pasión por diseñar experiencias elegantes, humanas y llenas de intención. Amo crear celebraciones que no solo se vean hermosas, sino que también se sientan cálidas, fluidas y emocionalmente conectadas.',
      'Mi enfoque combina sensibilidad, organización y atención genuina hacia cada pareja y sus invitados. Creo profundamente en el poder de los detalles, en la hospitalidad y en crear ambientes donde las personas puedan sentirse presentes, felices y verdaderamente disfrutando el momento.',
      'Inspirada por la belleza tropical de Costa Rica, el lujo sereno y las conexiones auténticas, mi propósito es transformar tus ideas en experiencias que realmente cuenten tu historia.',
    ],
    stats: [
      { n: '10+', label: 'Años de experiencia' },
      { n: '200+', label: 'Bodas realizadas' },
      { n: '100%', label: 'Dedicación total' },
    ],
    cta: 'Empecemos a contar tu historia',
  },
  en: {
    eyebrow: 'About me',
    headline: 'I believe in weddings that feel authentic, intimate, and deeply meaningful.',
    body: [
      'I\'m Kimaura, the person behind <em>Kimaura Allen Events</em> — a brand born from a passion for designing elegant, human, and intentional experiences. I love creating celebrations that not only look beautiful, but also feel warm, fluid, and emotionally connected.',
      'My approach combines sensitivity, organization, and genuine care for each couple and their guests. I deeply believe in the power of details, in hospitality, and in creating environments where people can feel present, joyful, and truly savoring the moment.',
      'Inspired by the tropical beauty of Costa Rica, serene luxury, and authentic connections, my purpose is to transform your ideas into experiences that truly tell your story.',
    ],
    stats: [
      { n: '10+', label: 'Years of experience' },
      { n: '200+', label: 'Weddings planned' },
      { n: '100%', label: 'Total dedication' },
    ],
    cta: 'Let\'s start telling your story',
  },
};

const c = copy[lang];
---

<section id="about" class="about">
  <div class="about-inner">

    <div class="photo-col">
      <div class="photo-frame">
        <img
          src="/kimaura-about.jpeg"
          alt="Kimaura Allen"
          class="about-img"
          loading="lazy"
        />
      </div>
      <div class="since-badge">
        <p class="since-text">Since<br/>2014</p>
      </div>
    </div>

    <div class="text-col">
      <span class="section-eyebrow">{c.eyebrow}</span>
      <h2 class="about-headline">{c.headline}</h2>

      {c.body.map(p => (
        <p class="about-body" set:html={p} />
      ))}

      <div class="about-stats">
        {c.stats.map((s, i) => (
          <>
            {i > 0 && <span class="stat-divider"></span>}
            <div class="stat">
              <span class="stat-number">{s.n}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          </>
        ))}
      </div>

      <a href="#contact" class="about-cta">
        {c.cta} <span class="cta-arrow">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .about {
    padding: 8rem 80px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .about-inner {
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 6rem;
    align-items: center;
  }

  .photo-col { position: relative; }

  .photo-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .about-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.8s ease;
  }

  .photo-frame:hover .about-img { transform: scale(1.03); }

  .since-badge {
    position: absolute;
    bottom: -1.5rem;
    right: -2rem;
    background: var(--soft-blush);
    padding: 1.75rem 2.25rem;
    z-index: 1;
  }

  .since-text {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 400;
    font-style: italic;
    color: var(--deep-earth);
    line-height: 1.2;
    margin: 0;
  }

  .section-eyebrow {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--warm-taupe);
    margin-bottom: 1.25rem;
  }

  .about-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    font-weight: 400;
    font-style: italic;
    color: var(--primary);
    line-height: 1.4;
    margin-bottom: 1.75rem;
  }

  .about-body {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.75;
    letter-spacing: 0.01em;
    margin-bottom: 1.1rem;
  }

  .about-body :global(em) { font-style: italic; color: var(--deep-earth); }

  .about-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 2rem 0 2.25rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--outline-variant);
    border-bottom: 1px solid var(--outline-variant);
  }

  .stat { display: flex; flex-direction: column; gap: 0.35rem; }

  .stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 400;
    color: var(--deep-earth);
    line-height: 1;
  }

  .stat-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--warm-taupe);
  }

  .stat-divider {
    width: 1px;
    height: 2.5rem;
    background: var(--outline-variant);
    flex-shrink: 0;
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--deep-earth);
    text-decoration: none;
    border-bottom: 1px solid var(--deep-earth);
    padding-bottom: 3px;
    transition: opacity 0.25s ease;
  }

  .about-cta:hover { opacity: 0.65; color: var(--deep-earth); }
  .about-cta:hover .cta-arrow { transform: translateX(4px); }
  .cta-arrow { transition: transform 0.25s ease; }

  @media (max-width: 900px) {
    .about { padding: 5rem 24px; }
    .about-inner { grid-template-columns: 1fr; gap: 3.5rem; }
    .photo-col { padding-bottom: 2.5rem; }
    .since-badge { right: 0; bottom: -1rem; }
    .about-stats { gap: 1.25rem; }
  }
</style>
