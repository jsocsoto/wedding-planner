---
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Servicios',
    title: 'Propuestas Exclusivas',
    sub: 'Cada servicio está diseñado para sentirse curado, exclusivo y emocionalmente conectado — no solo logístico, sino verdaderamente tuyo.',
    cta: 'Saber más',
    services: [
      { icon: 'travel_explore', tag: '01', title: 'Destination Experiences', desc: 'Logística integral y visión creativa para parejas que sueñan con casarse en el paraíso tropical de Costa Rica. Cada destino, curado con intención.' },
      { icon: 'event_available', tag: '02', title: 'Full Planning', desc: 'Desde la primera reunión hasta el último detalle del día, te acompaño en cada paso para que solo tengas que estar presente y disfrutar.' },
      { icon: 'concierge', tag: '03', title: 'Wedding Concierge', desc: 'Atención personalizada de alto nivel para tus invitados y anfitriones. Hospitalidad que convierte cada momento en una experiencia memorable.' },
      { icon: 'favorite', tag: '04', title: 'Elopements', desc: 'Celebraciones íntimas, cargadas de significado, en locaciones secretas y lugares de ensueño. Solo tú, tu pareja y la belleza de Costa Rica.' },
      { icon: 'lightbulb', tag: '05', title: 'Consultorías', desc: 'Asesoría estratégica y personalizada para parejas que buscan una guía experta en los momentos clave de su organización.', featured: true },
    ],
  },
  en: {
    eyebrow: 'Services',
    title: 'Exclusive Offerings',
    sub: 'Each service is designed to feel curated, exclusive, and emotionally connected — not just logistical, but truly yours.',
    cta: 'Learn more',
    services: [
      { icon: 'travel_explore', tag: '01', title: 'Destination Experiences', desc: 'End-to-end logistics and creative vision for couples dreaming of marrying in the tropical paradise of Costa Rica. Every destination, curated with intention.' },
      { icon: 'event_available', tag: '02', title: 'Full Planning', desc: 'From the first meeting to the last detail of the day, I accompany you every step of the way so you only need to be present and enjoy.' },
      { icon: 'concierge', tag: '03', title: 'Wedding Concierge', desc: 'High-touch personalized service for your guests and hosts. Hospitality that turns every moment into an unforgettable experience.' },
      { icon: 'favorite', tag: '04', title: 'Elopements', desc: 'Intimate, meaningful celebrations in secret locations and dreamy venues. Just you, your partner, and the beauty of Costa Rica.' },
      { icon: 'lightbulb', tag: '05', title: 'Consultations', desc: 'Strategic and personalized guidance for couples seeking expert advice at key moments in their planning journey.', featured: true },
    ],
  },
};

const c = copy[lang];
---

<section id="services" class="services">
  <div class="services-inner">
    <header class="section-header">
      <span class="section-eyebrow">{c.eyebrow}</span>
      <h2 class="section-title">{c.title}</h2>
      <p class="section-sub">{c.sub}</p>
    </header>

    <div class="services-grid">
      {c.services.map((s) => (
        <article class={`service-card ${s.featured ? 'service-card--featured' : ''}`}>
          <div class="card-top">
            <span class="card-tag">{s.tag}</span>
            <span class={`material-symbols-outlined card-icon ${s.featured ? 'card-icon--featured' : ''}`}>{s.icon}</span>
          </div>
          <h3 class="card-title">{s.title}</h3>
          <p class="card-desc">{s.desc}</p>
          <a href="#contact" class="card-link">{c.cta} <span>→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services { padding: 8rem 0; background: var(--surface-low); }

  .services-inner { max-width: 1280px; margin: 0 auto; padding: 0 80px; }

  .section-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: 4rem;
  }

  .section-eyebrow {
    grid-column: 1 / -1;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--warm-taupe);
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: var(--primary);
    margin: 0;
    line-height: 1.15;
  }

  .section-sub {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; }

  .service-card {
    background: var(--surface);
    padding: 2.75rem;
    display: flex;
    flex-direction: column;
    transition: background 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .service-card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--deep-earth);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }

  .service-card:hover::after { transform: scaleX(1); }

  .service-card--featured {
    grid-column: span 2;
    background: var(--soft-blush);
    flex-direction: row;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: flex-start;
  }

  .service-card--featured .card-top,
  .service-card--featured .card-title,
  .service-card--featured .card-desc,
  .service-card--featured .card-link { flex-basis: 100%; }

  .card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.75rem; }

  .card-tag {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--warm-taupe);
  }

  .card-icon {
    font-size: 1.75rem;
    color: var(--warm-taupe);
    font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 24;
  }

  .card-icon--featured { color: var(--deep-earth); }

  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--primary);
    margin-bottom: 0.875rem;
    line-height: 1.25;
  }

  .service-card--featured .card-title { color: var(--deep-earth); }

  .card-desc {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: auto;
    flex-grow: 1;
  }

  .service-card--featured .card-desc { color: var(--deep-earth); opacity: 0.8; }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--deep-earth);
    text-decoration: none;
    margin-top: 2rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .service-card:hover .card-link { opacity: 1; }
  .service-card--featured .card-link { opacity: 1; }

  @media (max-width: 900px) {
    .services-inner { padding: 0 24px; }
    .section-header { grid-template-columns: 1fr; gap: 1rem; }
    .services-grid { grid-template-columns: 1fr; gap: 1.5px; }
    .service-card--featured { grid-column: span 1; }
    .card-link { opacity: 1; }
  }
</style>
